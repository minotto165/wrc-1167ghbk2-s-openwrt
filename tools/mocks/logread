#!/bin/sh
# ============================================================
# logread mock — 802.1X 失敗っぽい行を出すだけ。
# setup.sh は logread の出力を grep -iE 'eap|8021x|802\.1x|deauth|wpa' に通す。
# POSIX sh のみ。
# ============================================================
[ -n "${UCI_STATE:-}" ] && printf '%s\n' "logread" >> "$UCI_STATE/calls.log"

cat <<'EOF'
